    "maxImageDimension": 1024,
    "thumbnailSize": 150,
    "maxHistoryItems": 100,
    "supportedLanguages": ["nb", "nn", "en", "nl", "es"]
  },
  "urls": {
    "privacy": "https://artsdatabanken.no/privacy",
    "terms": "https://artsdatabanken.no/terms",
    "support": "https://artsdatabanken.no/support"
  },
  "rssFeed": {
    "url": "https://ai.artsdatabanken.no/rss"
  }
}
