{
  "version": "4.0.0",
  "versionCode": 1,
  "bundleId": "no.artsdatabanken.artsorakel",
  "appName": "Artsorakel",
  "api": {
    "baseUrl": "https://ai.artsdatabanken.no/",
    "timeout": 60,
    "maxRetries": 3,
    "requiresAuth": true
  },
  "features": {
