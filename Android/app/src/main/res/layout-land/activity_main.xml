<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".activities.MainActivity">

    <!-- Main content in ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootConstraint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?attr/background_default"
        android:clipChildren="false">

        <!-- Header Section - full width across the top -->
        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:background="?attr/background_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button (hidden by default, replaces logo when shown) -->
            <ImageButton
                android:id="@+id/imageButtonHeaderBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="6dp"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone"
                app:tint="?attr/text_accent" />

            <ImageView
                android:id="@+id/imageViewLogo"
                android:layout_width="20dp"
                android:layout_height="60dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/ic_logo_color" />

            <ImageView
                android:id="@+id/imageViewSeparator"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                android:contentDescription="@string/separator"
                android:src="@drawable/chevron_separator"
                app:tint="?attr/background_strong" />

            <TextView
                android:id="@+id/appName"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                android:fontFamily="@font/chivo_bold"
                android:text="@string/app_name"
                android:gravity="center_vertical"
                android:textColor="?attr/text_primary"
                android:textSize="18sp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/appHeader"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                android:fontFamily="@font/chivo_regular"
                android:text="@string/app_name"
                android:gravity="center_vertical|center_horizontal"
                android:textColor="?attr/text_primary"
                android:textSize="18sp"
                android:layout_weight="1"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/buttonMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_description"
                android:src="@drawable/ic_menu"
                app:tint="?attr/text_accent" />

        </LinearLayout>

        <View
            android:id="@+id/headerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/border_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerRow" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBarResults"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="?attr/text_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/BottomButtonBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerDivider" />

        <!-- Timeout UI Container -->
        <LinearLayout
            android:id="@+id/timeoutContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:visibility="gone"
            android:padding="24dp"
            android:layout_marginTop="64dp"
            app:layout_constraintEnd_toStartOf="@id/BottomButtonBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBarResults">

            <TextView
                android:id="@+id/timeoutMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timeout_message"
                android:textSize="16sp"
                android:textColor="?attr/text_primary"
                android:fontFamily="@font/chivo_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAbort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/abort_button"
                android:backgroundTint="?attr/surface_primary"
                android:textColor="?attr/text_accent"
                android:elevation="16dp"
                app:backgroundTint="?attr/surface_subtle"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_close"
                app:iconTint="?attr/text_accent"
                app:strokeWidth="0dp" />

        </LinearLayout>

        <!-- Fragment Container for different UI states -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/background_subtle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/BottomButtonBar"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Side Button Bar for Landscape - below header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/BottomButtonBar"
            android:layout_width="148dp"
            android:layout_height="0dp"
            android:paddingHorizontal="16dp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="?attr/background_subtle">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCameraButton"
                android:layout_width="97dp"
                android:layout_height="97dp"
                android:backgroundTint="?attr/surface_accent"
                app:tint="?attr/surface_primary"
                android:contentDescription="@string/pick_image_camera"
                android:src="@drawable/ic_camera"
                app:fabCustomSize="97dp"
                app:fabSize="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:borderWidth="0dp"
                app:maxImageSize="47dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabCameraGallery"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/pick_image_gallery"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="?attr/surface_primary"
                app:icon="@drawable/ic_gallery"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/text_accent"
                app:cornerRadius="28dp"
                app:strokeColor="?attr/border_accent"
                app:strokeWidth="2dp"
                app:layout_constraintStart_toStartOf="@id/fabCameraButton"
                app:layout_constraintEnd_toEndOf="@id/fabCameraButton"
                app:layout_constraintBottom_toTopOf="@id/fabCameraButton" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Overlay Containers -->

        <FrameLayout
            android:id="@+id/historyOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/historicalResultsOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/speciesDetailsOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/settingsOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end">

        <include layout="@layout/nav_drawer_bottom_layout" />

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
