<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ backup and device transfer.
   Only backup shared preferences (user settings). Database and cached
   images are excluded by not including them.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Only backup user settings, exclude everything else by omission -->
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Same for device-to-device transfer -->
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>