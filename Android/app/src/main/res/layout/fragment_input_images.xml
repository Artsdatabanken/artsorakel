<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_subtle">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/InputsCard"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginHorizontal="16dp"
        android:backgroundTint="?attr/surface_primary"
        app:cardCornerRadius="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/InputsCardCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:backgroundTint="?attr/surface_subtle"
            android:contentDescription="@string/close"
            android:elevation="4dp"
            android:src="@drawable/ic_close"
            app:borderWidth="0dp"
            app:fabCustomSize="32dp"
            app:maxImageSize="16dp"
            app:tint="?attr/surface_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textAddImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="70dp"
                android:layout_marginTop="60dp"
                android:fontFamily="@font/chivo_regular"
                android:text="@string/add_pictures_hint"
                android:textAlignment="center"
                android:textColor="?attr/text_primary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/inputImages"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textAddImages">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHeaderImages"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                     />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonIdentify"
                android:layout_width="wrap_content"
                android:paddingHorizontal="22dp"
                android:layout_height="56dp"
                android:layout_gravity="top|center_horizontal"
                android:elevation="16dp"
                android:text="@string/identify"
                android:textColor="?attr/text_accent"
                app:backgroundTint="?attr/surface_primary"
                app:cornerRadius="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/inputImages"
                app:strokeColor="?attr/border_accent"
                app:strokeWidth="2dp"
                android:textAllCaps="false"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
