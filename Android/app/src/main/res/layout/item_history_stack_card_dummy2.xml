<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="1dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/surface_primary"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/border_default"
    android:clickable="false"
    android:focusable="false"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical">

        <!-- Thumbnail Image -->
        <include layout="@layout/item_image_thumbnail"
            android:id="@+id/imageViewThumbnail"
            android:layout_width="87dp"
            android:layout_height="87dp"
            />


        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            >

            <TextView
                android:id="@+id/textViewSpeciesName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:textColor="?attr/text_accent"
                android:fontFamily="@font/chivo_bold"
                android:maxLines="1"
                android:ellipsize="end"
                />

            <TextView
                android:id="@+id/textViewScientificName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?attr/text_secondary"
                android:fontFamily="@font/chivo_italic"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/textViewTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/text_secondary"
                android:fontFamily="@font/chivo_regular"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Arrow Icon -->
        <ImageView
            android:id="@+id/imageViewArrow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/details"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/surface_brand_1b" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>